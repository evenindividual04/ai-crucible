# Core LLM provider keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# API hardening controls
CRUCIBLE_API_KEY=change-me
CRUCIBLE_ENABLE_LIVE_RUNS=false

# Compose-backed persistence defaults
POSTGRES_USER=crucible
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crucible
DATABASE_URL=postgresql+psycopg://crucible:change-me@postgres:5432/crucible
REDIS_URL=redis://redis:6379/0
